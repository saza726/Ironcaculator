<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#15130f">
  <title>Iron Nest｜仰角計算器</title>
  <style>
    :root {
      --void: #080907;
      --iron-0: #11120f;
      --iron-1: #191a16;
      --iron-2: #24251f;
      --iron-3: #34342b;
      --edge: #575443;
      --brass-dark: #5d451d;
      --brass: #b1873f;
      --brass-light: #e0bd68;
      --paper: #d7cda9;
      --ink: #17160f;
      --amber: #ffb12e;
      --amber-hot: #ffd77a;
      --red: #e2523f;
      --green: #8dbf78;
      --muted: #9b9782;
      --shadow: 0 28px 90px rgba(0, 0, 0, 0.72);
    }

    * { box-sizing: border-box; }

    html { min-width: 320px; }

    body {
      margin: 0;
      min-height: 100vh;
      padding: clamp(14px, 3vw, 38px);
      color: var(--paper);
      background:
        radial-gradient(circle at 15% 15%, rgba(177, 135, 63, 0.09), transparent 26%),
        radial-gradient(circle at 82% 78%, rgba(142, 77, 38, 0.09), transparent 25%),
        repeating-linear-gradient(115deg, transparent 0 4px, rgba(255,255,255,.013) 4px 5px),
        #080907;
      font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      opacity: .28;
      background-image:
        radial-gradient(circle, rgba(255,255,255,.18) 0 1px, transparent 1.4px),
        radial-gradient(circle, rgba(0,0,0,.9) 0 1px, transparent 1.2px);
      background-position: 0 0, 7px 9px;
      background-size: 17px 19px, 21px 23px;
      pointer-events: none;
    }

    button, input { font: inherit; }

    .console {
      position: relative;
      width: min(1180px, 100%);
      margin: 0 auto;
      border: 1px solid #615c48;
      border-radius: 9px;
      background:
        linear-gradient(115deg, rgba(255,255,255,.035), transparent 24% 72%, rgba(0,0,0,.35)),
        repeating-linear-gradient(2deg, rgba(255,255,255,.012) 0 1px, transparent 1px 4px),
        var(--iron-1);
      box-shadow:
        inset 0 0 0 4px #10110e,
        inset 0 0 0 6px #3b392e,
        var(--shadow);
      overflow: hidden;
    }

    .console::before,
    .console::after {
      content: "";
      position: absolute;
      z-index: 10;
      top: 13px;
      width: 14px;
      height: 14px;
      border: 1px solid #27271f;
      border-radius: 50%;
      background:
        linear-gradient(45deg, transparent 43%, #22221b 44% 56%, transparent 57%),
        radial-gradient(circle at 36% 30%, #aaa27d 0 8%, #565342 28%, #22231d 72%);
      box-shadow: 0 1px 2px #000;
    }

    .console::before { left: 13px; }
    .console::after { right: 13px; transform: rotate(76deg); }

    .hazard-line {
      height: 12px;
      border-bottom: 1px solid #090a08;
      background: repeating-linear-gradient(135deg, #c2922e 0 15px, #191914 15px 30px);
      box-shadow: inset 0 -2px 4px rgba(0,0,0,.55);
      opacity: .78;
    }

    .masthead {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 22px;
      padding: 28px 36px 26px;
      border-bottom: 1px solid #4a4739;
      background:
        radial-gradient(circle at 12% 30%, rgba(255,177,46,.08), transparent 26%),
        linear-gradient(180deg, #24241e, #181914);
    }

    .insignia {
      width: 75px;
      height: 75px;
      padding: 8px;
      border: 1px solid var(--brass);
      border-radius: 50%;
      color: var(--brass-light);
      background: #11120f;
      box-shadow: inset 0 0 0 4px #28261d, 0 0 18px rgba(255,177,46,.08);
    }

    .kicker {
      margin: 0 0 7px;
      color: var(--brass-light);
      font: 700 11px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .24em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      color: #e1d8b8;
      font-family: Impact, "Arial Narrow", "Noto Sans TC", sans-serif;
      font-size: clamp(31px, 5vw, 58px);
      font-weight: 800;
      line-height: .95;
      letter-spacing: .055em;
      text-transform: uppercase;
      text-shadow: 0 2px 0 #000, 0 0 24px rgba(224,189,104,.09);
    }

    h1 span {
      display: block;
      margin-top: 9px;
      color: var(--muted);
      font: 700 13px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .29em;
    }

    .classification {
      min-width: 165px;
      padding: 13px 15px;
      border: 1px solid #705a2e;
      color: #d4b96e;
      background: rgba(18,16,11,.72);
      font: 700 10px/1.65 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .15em;
      text-align: center;
      text-transform: uppercase;
      transform: rotate(-1deg);
      box-shadow: inset 0 0 0 2px #181710;
    }

    .classification strong { color: var(--red); }

    .control-deck {
      display: grid;
      grid-template-columns: minmax(280px, .82fr) minmax(330px, 1.18fr);
      gap: 20px;
      padding: 25px 28px 22px;
    }

    .plate {
      position: relative;
      border: 1px solid #4c493b;
      border-radius: 5px;
      background:
        linear-gradient(135deg, rgba(255,255,255,.025), transparent 40%),
        #12130f;
      box-shadow: inset 0 0 0 3px #20211b, 0 4px 12px rgba(0,0,0,.26);
    }

    .plate-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 0;
      padding: 10px 14px;
      border-bottom: 1px solid #454235;
      color: #b7ad89;
      background: #1d1e19;
      font: 700 11px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    .serial { color: #6f6c5c; letter-spacing: .08em; }

    .input-body { padding: 22px; }

    label {
      display: block;
      margin-bottom: 9px;
      color: #aaa184;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .09em;
    }

    .input-shell {
      position: relative;
      display: flex;
      align-items: stretch;
      border: 1px solid #76683e;
      border-radius: 4px;
      background: #080a07;
      box-shadow: inset 0 0 0 3px #28261d, inset 0 0 22px #000;
      overflow: hidden;
    }

    input {
      width: 100%;
      min-width: 0;
      height: 72px;
      padding: 0 76px 0 18px;
      border: 0;
      outline: 0;
      color: var(--amber-hot);
      background:
        repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,177,46,.025) 3px 4px),
        transparent;
      font: 800 clamp(25px, 4vw, 37px)/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .04em;
      text-shadow: 0 0 10px rgba(255,177,46,.42);
    }

    input:focus { box-shadow: inset 0 0 20px rgba(255,177,46,.07); }
    input::placeholder { color: #5c583e; text-shadow: none; }

    .unit {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--brass-light);
      font: 800 13px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .15em;
      pointer-events: none;
    }

    .button-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      margin-top: 14px;
    }

    button {
      min-height: 50px;
      border: 1px solid #8c692c;
      border-radius: 3px;
      color: #17130a;
      background:
        linear-gradient(180deg, rgba(255,255,255,.18), transparent 40%),
        linear-gradient(180deg, #d8ad54, #8f6727);
      box-shadow: inset 0 0 0 2px rgba(255,220,132,.18), 0 3px 0 #493515;
      font-size: 13px;
      font-weight: 1000;
      letter-spacing: .14em;
      cursor: pointer;
      text-transform: uppercase;
      transition: filter 130ms ease, transform 130ms ease;
    }

    button:hover { filter: brightness(1.13); }
    button:active { transform: translateY(2px); box-shadow: inset 0 0 0 2px rgba(255,220,132,.18), 0 1px 0 #493515; }

    button.secondary {
      width: 54px;
      color: #b8b198;
      border-color: #4e4c3f;
      background: linear-gradient(180deg, #34352d, #1b1c17);
      box-shadow: inset 0 0 0 2px rgba(255,255,255,.025), 0 3px 0 #0a0b09;
    }

    .formula {
      margin: 18px 0 0;
      padding: 12px 13px;
      border-left: 3px solid var(--brass);
      color: #85816f;
      background: rgba(0,0,0,.18);
      font: 11px/1.75 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .formula strong { color: #c5b98f; }

    .lamp-bank {
      display: flex;
      gap: 18px;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px dashed #39382f;
    }

    .lamp-item {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #777466;
      font: 700 9px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .12em;
    }

    .lamp {
      width: 11px;
      height: 11px;
      border: 1px solid #050604;
      border-radius: 50%;
      background: #353427;
      box-shadow: inset 0 0 3px #000, 0 0 0 2px #4a483b;
    }

    .lamp.on-green { background: var(--green); box-shadow: inset 0 0 2px #e9ffd9, 0 0 0 2px #4a483b, 0 0 11px rgba(141,191,120,.65); }
    .lamp.on-amber { background: var(--amber); box-shadow: inset 0 0 2px #fff0ba, 0 0 0 2px #4a483b, 0 0 11px rgba(255,177,46,.65); }
    .lamp.on-red { background: var(--red); box-shadow: inset 0 0 2px #ffd0c8, 0 0 0 2px #4a483b, 0 0 11px rgba(226,82,63,.7); }

    .gauge-body {
      display: grid;
      grid-template-columns: minmax(230px, 1fr) minmax(150px, .68fr);
      align-items: center;
      gap: 20px;
      min-height: 257px;
      padding: 18px 20px 20px;
    }

    .dial {
      position: relative;
      width: min(100%, 330px);
      aspect-ratio: 2 / 1.08;
      justify-self: center;
      overflow: hidden;
      border: 7px solid #171813;
      border-bottom-width: 10px;
      border-radius: 180px 180px 16px 16px;
      background:
        repeating-radial-gradient(circle at 50% 100%, transparent 0 17px, rgba(0,0,0,.04) 18px 19px),
        linear-gradient(180deg, #d4c99f, #8b846c);
      box-shadow:
        0 0 0 2px #6e6547,
        0 0 0 5px #25251e,
        inset 0 0 30px rgba(0,0,0,.48),
        0 7px 16px #000;
    }

    .dial::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(106deg, transparent 25%, rgba(255,255,255,.28) 37%, transparent 49%),
        repeating-linear-gradient(90deg, transparent 0 7px, rgba(0,0,0,.018) 7px 8px);
      pointer-events: none;
    }

    .ticks {
      position: absolute;
      inset: 12px 12px 0;
      width: calc(100% - 24px);
      height: calc(100% - 12px);
      color: var(--ink);
    }

    .needle {
      position: absolute;
      left: calc(50% - 2px);
      bottom: 7%;
      z-index: 3;
      width: 4px;
      height: 70%;
      border-radius: 80% 80% 30% 30%;
      background: linear-gradient(90deg, #5c130d, #e04d37 45% 65%, #64120c);
      box-shadow: 0 1px 2px #000;
      transform: rotate(-90deg);
      transform-origin: 50% 93%;
      transition: transform 520ms cubic-bezier(.2,.8,.2,1);
    }

    .needle-cap {
      position: absolute;
      left: 50%;
      bottom: 3.5%;
      z-index: 4;
      width: 22px;
      height: 22px;
      border: 2px solid #332a17;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #f1c569 0 8%, #98702c 32%, #35250f 76%);
      box-shadow: 0 2px 4px #000;
      transform: translateX(-50%);
    }

    .readout { min-width: 0; }

    .readout-label {
      margin: 0 0 7px;
      color: #7c7866;
      font: 800 9px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    .angle-value {
      display: block;
      overflow: hidden;
      color: var(--amber-hot);
      font: 900 clamp(30px, 5vw, 51px)/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: -.06em;
      text-overflow: ellipsis;
      text-shadow: 0 0 13px rgba(255,177,46,.38);
      white-space: nowrap;
    }

    .charge-value {
      display: block;
      margin-top: 13px;
      color: #bcb393;
      font: 800 14px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .system-message {
      min-height: 3.4em;
      margin: 14px 0 0;
      color: #8d8976;
      font-size: 12px;
      line-height: 1.7;
    }

    .system-message.error { color: #e88776; }

    .solution-panel {
      margin: 0 28px 28px;
      border: 1px solid #4c493b;
      border-radius: 5px;
      background: #10110e;
      box-shadow: inset 0 0 0 3px #1e1f19;
    }

    .solution-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 13px 16px;
      border-bottom: 1px solid #454235;
      background: #1d1e19;
    }

    .solution-head h2 {
      margin: 0;
      color: #c2b791;
      font: 800 12px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    .distance-repeat {
      color: #777365;
      font: 700 10px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .1em;
    }

    .solutions {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1px;
      background: #3b392e;
    }

    .solution {
      position: relative;
      min-width: 0;
      padding: 17px 13px 16px;
      background:
        linear-gradient(145deg, rgba(255,255,255,.025), transparent 45%),
        #151612;
      transition: background 180ms ease, box-shadow 180ms ease;
    }

    .solution::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .solution.recommended {
      z-index: 2;
      background:
        linear-gradient(145deg, rgba(255,177,46,.13), transparent 54%),
        #1b1a13;
      box-shadow: inset 0 0 0 2px var(--brass-light), 0 0 22px rgba(255,177,46,.12);
    }

    .solution.blocked { opacity: .52; }

    .charge-number {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      color: #9d9578;
      font: 800 10px/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .12em;
    }

    .mini-lamp {
      width: 8px;
      height: 8px;
      flex: 0 0 auto;
      border-radius: 50%;
      background: #444235;
      box-shadow: inset 0 0 3px #000;
    }

    .solution.valid .mini-lamp {
      background: var(--green);
      box-shadow: 0 0 8px rgba(141,191,120,.58);
    }

    .solution.blocked .mini-lamp {
      background: var(--red);
      box-shadow: 0 0 8px rgba(226,82,63,.58);
    }

    .solution-angle {
      display: block;
      margin: 12px 0 9px;
      overflow: hidden;
      color: #d6cca9;
      font: 900 clamp(20px, 2.5vw, 29px)/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: -.055em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .solution.recommended .solution-angle { color: var(--amber-hot); text-shadow: 0 0 10px rgba(255,177,46,.3); }

    .solution-range,
    .solution-status {
      display: block;
      color: #777365;
      font: 700 9px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .04em;
    }

    .solution-status { margin-top: 4px; color: #918a70; }
    .solution.recommended .solution-status { color: var(--brass-light); }
    .solution.blocked .solution-status { color: #c37568; }

    .recommended-tag {
      display: none;
      margin-top: 10px;
      padding: 4px 5px;
      border: 1px solid #826226;
      color: var(--amber);
      background: rgba(255,177,46,.06);
      font: 900 8px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .08em;
      text-align: center;
    }

    .solution.recommended .recommended-tag { display: block; }

    footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 15px 30px 17px;
      border-top: 1px solid #3f3d32;
      color: #666354;
      background: #11120f;
      font: 700 9px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .scanline {
      position: absolute;
      z-index: 8;
      left: 0;
      right: 0;
      top: -15%;
      height: 80px;
      opacity: .11;
      background: linear-gradient(180deg, transparent, rgba(255,183,66,.16), transparent);
      pointer-events: none;
      animation: scan 7s linear infinite;
    }

    @keyframes scan {
      from { transform: translateY(-100px); }
      to { transform: translateY(1200px); }
    }

    @media (max-width: 900px) {
      .control-deck { grid-template-columns: 1fr; }
      .solutions { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .masthead { grid-template-columns: auto 1fr; }
      .classification { grid-column: 1 / -1; justify-self: start; }
    }

    @media (max-width: 580px) {
      body { padding: 8px; }
      .masthead { grid-template-columns: 1fr; gap: 14px; padding: 26px 22px 22px; }
      .insignia { width: 62px; height: 62px; }
      .classification { min-width: 0; }
      .control-deck { padding: 16px 15px; }
      .gauge-body { grid-template-columns: 1fr; }
      .readout { text-align: center; }
      .solutions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .solution-panel { margin: 0 15px 16px; }
      .solution-head { align-items: flex-start; flex-direction: column; }
      footer { flex-direction: column; padding: 14px 18px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
  </style>
</head>
<body>
  <article class="console">
    <div class="scanline" aria-hidden="true"></div>
    <div class="hazard-line" aria-hidden="true"></div>

    <header class="masthead">
      <svg class="insignia" viewBox="0 0 80 80" role="img" aria-label="Iron Nest 火砲徽章">
        <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M13 50h54M25 50l4-14h22l5 14M35 36v-8h10v8M41 28l19-11 2 4-17 12M24 56h32M30 62h20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="bevel"/>
        <path d="M17 24l5 2M63 24l-5 2M40 9v6" fill="none" stroke="currentColor" stroke-width="2"/>
      </svg>

      <div>
        <p class="kicker">Iron Nest · Heavy Turret Fire Control</p>
        <h1>Iron Nest<span>仰角計算器 // Elevation Computer</span></h1>
      </div>

      <div class="classification">
        Field Utility No. 60<br>
        <strong>Personal Use</strong><br>
        Range Scale · Kilometres
      </div>
    </header>

    <main>
      <div class="control-deck">
        <section class="plate" aria-labelledby="input-title">
          <h2 class="plate-title" id="input-title">
            <span>01 · Target Range Input</span>
            <span class="serial">IN-05/30</span>
          </h2>
          <div class="input-body">
            <form id="calculator-form" novalidate>
              <label for="distance">目標距離｜TARGET DISTANCE（小數後 2 位）</label>
              <div class="input-shell">
                <input id="distance" name="distance" type="number" min="0.01" max="30" step="0.01" inputmode="decimal" placeholder="07.50" autocomplete="off" required autofocus>
                <span class="unit">KM</span>
              </div>
              <div class="button-row">
                <button type="submit">Engage · 計算 1—6 發</button>
                <button class="secondary" id="reset-button" type="button" aria-label="清除數值">↺</button>
              </div>
            </form>

            <p class="formula">
              <strong>FIRING RULE</strong><br>
              仰角＝距離 × 12 ÷ 裝藥量<br>
              每發最大射程 5 km｜仰角上限 60°
            </p>

            <div class="lamp-bank" aria-hidden="true">
              <span class="lamp-item"><i class="lamp on-green" id="ready-lamp"></i> READY</span>
              <span class="lamp-item"><i class="lamp" id="solution-lamp"></i> SOLUTION</span>
              <span class="lamp-item"><i class="lamp" id="warning-lamp"></i> LIMIT</span>
            </div>
          </div>
        </section>

        <section class="plate" aria-labelledby="gauge-title">
          <h2 class="plate-title" id="gauge-title">
            <span>02 · Recommended Solution</span>
            <span class="serial">MAX 60 DEG</span>
          </h2>
          <div class="gauge-body">
            <div class="dial" aria-hidden="true">
              <svg class="ticks" viewBox="0 0 320 170">
                <path d="M22 151 A138 138 0 0 1 298 151" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M22 151h17M64 55l12 12M160 14v19M256 55l-12 12M298 151h-17" fill="none" stroke="currentColor" stroke-width="3"/>
                <path d="M45 123l8 3M55 83l8 5M91 36l5 9M108 29l4 10M142 17l2 11M178 17l-2 11M212 29l-4 10M229 36l-5 9M265 83l-8 5M275 123l-8 3" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <g fill="currentColor" font-family="monospace" font-size="13" font-weight="700" text-anchor="middle">
                  <text x="29" y="145">0</text><text x="60" y="78">15</text><text x="160" y="47">30</text><text x="260" y="78">45</text><text x="291" y="145">60</text>
                  <text x="160" y="67" font-size="10">ELEVATION</text><text x="160" y="81" font-size="8">DEGREES</text>
                </g>
              </svg>
              <div class="needle" id="needle"></div>
              <div class="needle-cap"></div>
            </div>

            <div class="readout" aria-live="polite" aria-atomic="true">
              <p class="readout-label">Recommended Elevation</p>
              <output class="angle-value" id="recommended-angle">—</output>
              <strong class="charge-value" id="recommended-charge">等待距離輸入</strong>
              <p class="system-message" id="system-message">系統待命。輸入距離即可同步計算 1～6 發裝藥。</p>
            </div>
          </div>
        </section>
      </div>

      <section class="solution-panel" aria-labelledby="solution-title">
        <div class="solution-head">
          <h2 id="solution-title">03 · All Charge Solutions｜1—6 發仰角一覽</h2>
          <span class="distance-repeat" id="distance-repeat">TARGET RANGE · — KM</span>
        </div>
        <div class="solutions" id="solutions"></div>
      </section>
    </main>

    <footer>
      <span>Iron Nest Personal Fire-Control Utility</span>
      <span>Simplified in-game calculation · Not a physical ballistics model</span>
    </footer>
    <div class="hazard-line" aria-hidden="true"></div>
  </article>

  <script>
    (() => {
      "use strict";

      const MAX_CHARGES = 6;
      const MAX_ANGLE = 60;
      const RANGE_PER_CHARGE = 5;

      const form = document.getElementById("calculator-form");
      const distanceInput = document.getElementById("distance");
      const resetButton = document.getElementById("reset-button");
      const solutions = document.getElementById("solutions");
      const needle = document.getElementById("needle");
      const recommendedAngle = document.getElementById("recommended-angle");
      const recommendedCharge = document.getElementById("recommended-charge");
      const systemMessage = document.getElementById("system-message");
      const distanceRepeat = document.getElementById("distance-repeat");
      const solutionLamp = document.getElementById("solution-lamp");
      const warningLamp = document.getElementById("warning-lamp");

      const makeCards = () => {
        solutions.innerHTML = Array.from({ length: MAX_CHARGES }, (_, index) => {
          const charge = index + 1;
          return `
            <article class="solution" id="charge-${charge}">
              <span class="charge-number">CHARGE 0${charge}<i class="mini-lamp"></i></span>
              <output class="solution-angle" id="angle-${charge}">—</output>
              <span class="solution-range">MAX ${String(charge * RANGE_PER_CHARGE).padStart(2, "0")}.00 KM</span>
              <span class="solution-status" id="status-${charge}">STANDBY</span>
              <span class="recommended-tag">MINIMUM · 建議</span>
            </article>`;
        }).join("");
      };

      const setNeedle = (angle) => {
        const safeAngle = Math.max(0, Math.min(angle, MAX_ANGLE));
        needle.style.transform = `rotate(${-90 + safeAngle * 3}deg)`;
      };

      const setLampState = (hasSolution, hasWarning) => {
        solutionLamp.className = `lamp${hasSolution ? " on-amber" : ""}`;
        warningLamp.className = `lamp${hasWarning ? " on-red" : ""}`;
      };

      const clearCards = () => {
        for (let charge = 1; charge <= MAX_CHARGES; charge += 1) {
          const card = document.getElementById(`charge-${charge}`);
          card.className = "solution";
          document.getElementById(`angle-${charge}`).textContent = "—";
          document.getElementById(`status-${charge}`).textContent = "STANDBY";
        }
      };

      const showIdle = (message = "系統待命。輸入距離即可同步計算 1～6 發裝藥。", isError = false) => {
        clearCards();
        recommendedAngle.textContent = "—";
        recommendedCharge.textContent = "等待距離輸入";
        systemMessage.textContent = message;
        systemMessage.classList.toggle("error", isError);
        distanceRepeat.textContent = "TARGET RANGE · — KM";
        setNeedle(0);
        setLampState(false, isError);
      };

      const calculate = () => {
        const rawDistance = distanceInput.value.trim();

        if (!rawDistance) {
          showIdle();
          return;
        }

        if (!/^\d+(?:\.\d{1,2})?$/.test(rawDistance)) {
          showIdle("輸入格式錯誤：距離最多只能保留小數點後 2 位。", true);
          return;
        }

        const distance = Number(rawDistance);
        if (!Number.isFinite(distance) || distance <= 0) {
          showIdle("輸入錯誤：目標距離必須大於 0 km。", true);
          return;
        }

        distanceRepeat.textContent = `TARGET RANGE · ${distance.toFixed(2)} KM`;
        const minimumCharge = Math.ceil(distance / RANGE_PER_CHARGE);
        let hasValidSolution = false;
        let hasBlockedSolution = false;

        for (let charge = 1; charge <= MAX_CHARGES; charge += 1) {
          const angle = distance * 12 / charge;
          const valid = angle <= MAX_ANGLE;
          const card = document.getElementById(`charge-${charge}`);
          const angleNode = document.getElementById(`angle-${charge}`);
          const statusNode = document.getElementById(`status-${charge}`);

          card.className = `solution ${valid ? "valid" : "blocked"}`;
          angleNode.textContent = `${angle.toFixed(2)}°`;
          statusNode.textContent = valid ? "可用 · IN RANGE" : "超過 60° · LIMIT";

          if (valid && charge === minimumCharge) card.classList.add("recommended");
          hasValidSolution ||= valid;
          hasBlockedSolution ||= !valid;
        }

        if (distance > MAX_CHARGES * RANGE_PER_CHARGE) {
          recommendedAngle.textContent = ">60°";
          recommendedCharge.textContent = "超出 6 發最大射程";
          systemMessage.textContent = "目標超過 30 km，目前所有裝藥方案均不可用。";
          systemMessage.classList.add("error");
          setNeedle(MAX_ANGLE);
          setLampState(false, true);
          return;
        }

        const bestAngle = distance * 12 / minimumCharge;
        recommendedAngle.textContent = `${bestAngle.toFixed(2)}°`;
        recommendedCharge.textContent = `建議 ${minimumCharge} 發裝藥`;
        systemMessage.textContent = `最低可用裝藥為 ${minimumCharge} 發；其餘綠燈方案亦在 60° 限制內。`;
        systemMessage.classList.remove("error");
        setNeedle(bestAngle);
        setLampState(hasValidSolution, hasBlockedSolution);
      };

      makeCards();
      showIdle();

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        calculate();
      });

      distanceInput.addEventListener("input", calculate);

      resetButton.addEventListener("click", () => {
        distanceInput.value = "";
        showIdle();
        distanceInput.focus();
      });
    })();
  </script>
</body>
</html>
